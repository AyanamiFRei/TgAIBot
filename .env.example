# Telegram token from @BotFather
BOT_TOKEN=

# Cloudflare Workers AI API token and account endpoint.
# The URL may end in /ai/run or /ai/v1; the bot normalizes /ai/run to /ai/v1.
CLOUDFLARE_API_KEY=
CLOUDFLARE_USER_URL=https://api.cloudflare.com/client/v4/accounts/ACCOUNT_ID/ai/run

# NVIDIA NIM (https://integrate.api.nvidia.com) — OpenAI-compatible
# /chat/completions. Vision is built into the model (multimodal).
NVIDIA_API_KEY=nvapi-
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.3-flash

# AI_PROVIDER / VISION_PROVIDER select which provider handles text and
# media turns: cloudflare | mistral | nvidia (defaults: cloudflare / same as text).
AI_PROVIDER=nvidia
VISION_PROVIDER=nvidia

# One multimodal model handles text, photos and sticker thumbnails.
CLOUDFLARE_MODEL=@cf/google/gemma-4-26b-a4b-it

HISTORY_WINDOW=400
HISTORY_CHARS=12000
MAX_TOKENS=512
TEMPERATURE=0.7
MSG_SPLIT_DELAY=0.8
DB_PATH=bot.db
STICKER_PACK=

# Proactive messages (disabled by default).
PROACTIVE=false
PROACTIVE_MIN_SILENCE_H=3
PROACTIVE_MAX_SILENCE_H=8
PROACTIVE_MIN_GAP_H=4.0
PROACTIVE_MAX_PER_DAY=2
PROACTIVE_MIN_LOOP_MIN=10.0
PROACTIVE_TEMPERATURE=0.7
PROACTIVE_MAX_TOKENS=256

# Session memory (intermediate layer)
SESSION_TIMEOUT_H=3.5
SESSION_KEEP_RECENT=10
